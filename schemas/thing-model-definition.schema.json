{
  "type": "object",
  "properties": {
    "format": {
      "const": "thing-model-definition/1.0"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "numeric_step_defaults": {
      "type": "object",
      "properties": {
        "integer": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "number": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "explicit_constraint_takes_precedence": {
          "const": true
        }
      },
      "required": [
        "integer",
        "number",
        "explicit_constraint_takes_precedence"
      ],
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "input": {
            "$ref": "#/$defs/node"
          },
          "output": {
            "$ref": "#/$defs/node"
          },
          "availability": {
            "enum": [
              "active",
              "suspended"
            ]
          }
        },
        "required": [
          "input",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "properties",
    "services",
    "events"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "id": [
      "format",
      "version"
    ],
    "version": [
      "format",
      "id"
    ]
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:momcozy:thing-model-definition:1.0",
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "integer",
            "number",
            "boolean",
            "string"
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "items": {
          "$ref": "#/$defs/node"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "format": {
          "const": "hex"
        },
        "access": {
          "enum": [
            "r",
            "w",
            "rw"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties",
              "additionalProperties"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        }
      ]
    }
  }
}
